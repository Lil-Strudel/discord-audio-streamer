# Build output
/build/bin/
/dist/
*.exe
*.syso

# Wails
# Keep the directory: main.go embeds it, so a fresh clone must still build.
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/node_modules/
/frontend/wailsjs/

# Embedded helper binaries (fetched at build time, never committed)
/internal/ffmpeg/assets/*.gz
/internal/ytdlp/assets/*.gz

# Local toolchain / scratch
/.task/
/scripts/vendor/
*.log

# Editor
.idea/
.vscode/
*.swp

# Wails build cache
/frontend/package.json.md5
